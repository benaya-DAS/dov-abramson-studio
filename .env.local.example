# Supabase project credentials.
# Find these under Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The Google Workspace domain allowed to sign in (used as a UX hint on the
# Google account chooser). The real security boundary is enforced in
# supabase/schema.sql (public.allowed_domains + the enforce_studio_domain
# trigger) — update that table too when changing this value.
NEXT_PUBLIC_STUDIO_DOMAIN=dovabramson.com
